# Aplicación (conexión de runtime; puede apuntar a Hostinger)
APP_NAME=Finanzas Personales
APP_DB_HOST=db_dev
APP_DB_PORT=3306
APP_DB_NAME=finanzas_personales_dev
APP_DB_USER=finanzas_dev
APP_DB_PASSWORD=finanzas_dev_pass

# Protección de conexión remota
# Opciones sugeridas: require, verify_ca, verify_identity
APP_DB_SSL_MODE=require
APP_DB_SSL_CA=
APP_DB_SSL_CERT=
APP_DB_SSL_KEY=
APP_DB_SSL_VERIFY_SERVER_CERT=1
# Solo para desarrollo controlado: 1 permite remoto sin TLS estricto
APP_DB_ALLOW_INSECURE_REMOTE=0

# Puertos locales
FP_APP_PORT=8082
FP_DB_DEV_PORT=3310
FP_DB_TEST_PORT=3311

# Base de desarrollo (persistente)
FP_DB_DEV_NAME=finanzas_personales_dev
FP_DB_DEV_USER=finanzas_dev
FP_DB_DEV_PASSWORD=finanzas_dev_pass
FP_DB_DEV_ROOT_PASSWORD=finanzas_dev_root_pass

# Base de pruebas (desechable)
FP_DB_TEST_NAME=finanzas_personales_test
FP_DB_TEST_USER=finanzas_test
FP_DB_TEST_PASSWORD=finanzas_test_pass
FP_DB_TEST_ROOT_PASSWORD=finanzas_test_root_pass
